{
  "name": "agent-architecture-lab-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive reference explorer for the Agent Architecture Lab. Reads generated JSON from public/data; contains no agent logic.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173 --strictPort",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
